# Repellent Operations — ortam degiskenleri.
#
# Bu dosyayi `.env` olarak kopyalayip doldurun. `.env` ASLA commit edilmez.
# Sunucu bu degerleri okuyup tarayiciya /env.js olarak servis eder; boylece
# anahtarlar depoda durmaz ve staging/production farkli projelere bakabilir.

# Supabase proje adresi — Supabase panelinde Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# "anon public" anahtari. Tarayiciya gitmesi TASARIM GEREGI guvenlidir: tek
# basina hicbir yetki vermez, erisim RLS politikalariyla belirlenir
# (supabase/migrations/20260905000002_rls.sql).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx.xxxxxxxx

# "service_role" anahtari. RLS'i TAMAMEN BYPASS EDER.
#   - Tarayiciya asla gonderilmez, /env.js iceriginde yer almaz.
#   - Yalnizca sunucu tarafi yonetim islerinde (kullanici davet etme, toplu veri
#     tasima) kullanilir.
#   - Bu deger sizdiysa Supabase panelinden derhal rotate edin.
SUPABASE_SERVICE_ROLE_KEY=

# Uygulama sunucusunun dinledigi port.
PORT=4173
